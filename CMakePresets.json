{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JANUSGATE_HARDENING": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "JANUSGATE_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "environment": {
        "CC": "clang"
      },
      "cacheVariables": {
        "JANUSGATE_ENABLE_FUZZING": "ON",
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang-ubsan",
      "inherits": "debug",
      "environment": {
        "CC": "clang"
      },
      "cacheVariables": {
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "alpine-debug",
      "inherits": "debug"
    },
    {
      "name": "alpine-asan",
      "inherits": "asan"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "clang-ubsan",
      "configurePreset": "clang-ubsan"
    },
    {
      "name": "alpine-debug",
      "configurePreset": "alpine-debug"
    },
    {
      "name": "alpine-asan",
      "configurePreset": "alpine-asan"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-ubsan",
      "configurePreset": "clang-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "alpine-debug",
      "configurePreset": "alpine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "alpine-asan",
      "configurePreset": "alpine-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
