{
  "version": 6,
  "vendor": {
    "github.com/marcofortina/JanusGate/metadata/1": {
      "license": "AGPL-3.0-or-later",
      "copyright": "Copyright (C) 2026 Marco Fortina <marco_fortina@hotmail.it>"
    }
  },
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_SYSCONFDIR": "/etc",
        "CMAKE_INSTALL_LOCALSTATEDIR": "/var",
        "CMAKE_INSTALL_RUNSTATEDIR": "/run",
        "JANUSGATE_HARDENING": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "JANUSGATE_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "debug",
      "environment": {
        "CC": "clang"
      },
      "cacheVariables": {
        "JANUSGATE_ENABLE_FUZZING": "ON",
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "performance",
      "inherits": "release",
      "cacheVariables": {
        "JANUSGATE_BUILD_BENCHMARKS": "ON",
        "JANUSGATE_BUILD_DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "clang-ubsan",
      "inherits": "debug",
      "environment": {
        "CC": "clang"
      },
      "cacheVariables": {
        "JANUSGATE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "alpine-debug",
      "inherits": "debug"
    },
    {
      "name": "alpine-asan",
      "inherits": "asan"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "performance",
      "configurePreset": "performance"
    },
    {
      "name": "clang-ubsan",
      "configurePreset": "clang-ubsan"
    },
    {
      "name": "alpine-debug",
      "configurePreset": "alpine-debug"
    },
    {
      "name": "alpine-asan",
      "configurePreset": "alpine-asan"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-ubsan",
      "configurePreset": "clang-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "alpine-debug",
      "configurePreset": "alpine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "alpine-asan",
      "configurePreset": "alpine-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
