# shellcheck disable=SC2034

name="JanusGate network helper"
description="Privileged JanusGate bridge and nftables helper"
command="/usr/sbin/janusgate-netd"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=30

depend() {
    need localmount
    before janusgated
}

start_pre() {
    checkpath --directory --owner root:janusgate-control --mode 0750 \
        /run/janusgate
}
