# shellcheck disable=SC2034

name="JanusGate web administration"
description="Unprivileged JanusGate HTTPS administration service"
command="/usr/sbin/janusgate-web"
command_args="--hsts"
command_user="janusgate-web:janusgate-web"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=30

depend() {
    need janusgated
    use logger
}
