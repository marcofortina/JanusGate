set -eu

pid_file=/run/janusgated.pid

# Stop one recorded process and wait until its PID no longer matches.
stop_service()
{
    attempts=0

    start-stop-daemon -K -q -p "$pid_file" -s TERM 2>/dev/null || true
    while start-stop-daemon -K -q -t -p "$pid_file" 2>/dev/null; do
        if [ "$attempts" -eq 10 ]; then
            start-stop-daemon -K -q -p "$pid_file" -s KILL 2>/dev/null ||
                true
        fi
        [ "$attempts" -lt 15 ] || return 1
        attempts=$((attempts + 1))
        sleep 1
    done
}

case ${1-} in
    start)
        mkdir -p /run/janusgate/control
        chown janusgate:janusgate-control /run/janusgate/control
        chmod 0750 /run/janusgate/control
        start-stop-daemon -S -q -b -m -p "$pid_file" \
            -x /usr/sbin/janusgated
        ;;
    stop)
        stop_service
        rm -f "$pid_file"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}" >&2
        exit 2
        ;;
esac
